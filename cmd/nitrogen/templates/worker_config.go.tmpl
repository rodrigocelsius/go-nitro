package config

import nitro "github.com/rodrigocelsius/go-nitro/pkg/v2"

type Config struct {
	HealthPort  int    `env:"HEALTH_PORT" default:"8081"`
	Env         string `env:"NITRO_ENV" default:"production"`
	ServiceName string `env:"SERVICE_NAME" default:"worker"`
	QueueName   string `env:"QUEUE_NAME" default:"jobs"`
	RoutingKey  string `env:"ROUTING_KEY" default:"jobs"`
	// The broker is read by nitro.QueueFromEnv (NATS_URL, RABBITMQ_URL,
	// KAFKA_BROKERS, NITRO_QUEUE), not here.
}

func Load() (Config, error) {
	// Export .env / .env.local to the process (real env vars win) so code that
	// reads os.Getenv — sqladapter.OpenEnv, OTEL, REDIS_ADDR — sees the same
	// values as Config. No-op when the files are absent (containers).
	nitro.LoadDotEnv()
	return nitro.ConfigOf[Config]()
}
