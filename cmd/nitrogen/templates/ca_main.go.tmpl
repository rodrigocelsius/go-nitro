package main

import (
	"fmt"
	"log"

	nitro "github.com/rodrigocelsius/go-nitro/pkg/v2"

	"%[1]s/internal/config"
	"%[1]s/internal/handler"
)

func main() {
	cfg, err := config.Load()
	if err != nil {
		log.Fatalf("config: %%v", err)
	}

	app := nitro.New()
	handler.Register(app)

	nitro.Ok(app.Listen(fmt.Sprintf(":%%d", cfg.Port)))
}
